# Server
PORT=4000
NODE_ENV=development
# Comma-separated list of allowed frontend origins (dev + deployed):
CLIENT_URL=http://localhost:5173,https://your-app.vercel.app
# This backend's own public URL (used to build Zernio's OAuth redirect_url).
# In local dev this must be a tunnel URL (e.g. ngrok) since Zernio needs to
# reach it from the internet - see README for the OAuth setup walkthrough.
APP_BASE_URL=http://localhost:4000

# Database (local Mongo or an Atlas connection string)
MONGO_URI=mongodb://127.0.0.1:27017/loop_scheduler

# Auth
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d

# Zernio API (social publishing) - https://docs.zernio.com
# Leave ZERNIO_MODE=mock to run with safe sample data (no real posts go out).
# To go live: sign up at https://zernio.com, create an API key under
# Settings -> API Keys (format sk_...), and set the two values below.
ZERNIO_MODE=mock
ZERNIO_API_KEY=
ZERNIO_API_BASE_URL=https://zernio.com/api/v1
# Set this to the secret you enter when creating a webhook endpoint in the
# Zernio dashboard (Webhooks -> Create endpoint). Verifies incoming webhook
# requests are actually from Zernio. Safe to leave blank in mock mode.
ZERNIO_WEBHOOK_SECRET=

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# AI content/image generation
AI_PROVIDER=cloudflare
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_IMAGE_MODEL=@cf/black-forest-labs/flux-1-schnell
CLOUDFLARE_TEXT_MODEL=@cf/meta/llama-3.2-3b-instruct